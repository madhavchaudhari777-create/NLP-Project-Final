# Flask Configuration
FLASK_SECRET_KEY=change-this-to-a-secure-random-secret-key

# OpenAI Configuration (Optional - platform works with local NLP fallback if not provided)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration
# For local development (SQLite)
DATABASE_PATH=instance/interviews.db

# For production (PostgreSQL) - uncomment and set
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: Redis for session storage (production)
# REDIS_URL=redis://localhost:6379/0

# Optional: Flask environment
# FLASK_ENV=development
# FLASK_DEBUG=1